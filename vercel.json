{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/shop",
      "destination": "/api/owner?module=shop"
    },
    {
      "source": "/api/owner/users",
      "destination": "/api/owner?action=users"
    },
    {
      "source": "/api/owner/audit",
      "destination": "/api/owner?action=audit"
    },
    {
      "source": "/api/owner/update-role",
      "destination": "/api/owner?action=update-role"
    },
    {
      "source": "/api/owner/set-blocked",
      "destination": "/api/owner?action=set-blocked"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
