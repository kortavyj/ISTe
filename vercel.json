{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/((?!api/|assets/|data/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=15552000"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "off"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/tournaments-alerts",
      "destination": "/api/tournaments?route=alerts"
    },
    {
      "source": "/api/tournaments-owner",
      "destination": "/api/tournaments?route=owner"
    },
    {
      "source": "/api/tournaments-match-confirm",
      "destination": "/api/tournaments?route=match-confirm"
    },
    {
      "source": "/api/tournaments-team-apply",
      "destination": "/api/tournaments?route=team-apply"
    },
    {
      "source": "/api/tournaments-team-review",
      "destination": "/api/tournaments?route=team-review"
    },
    {
      "source": "/api/tournaments-team-list",
      "destination": "/api/tournaments?route=team-list"
    },
    {
      "source": "/api/tournaments-bracket-generate",
      "destination": "/api/tournaments?route=bracket-generate"
    },
    {
      "source": "/api/tournaments-bracket",
      "destination": "/api/tournaments?route=bracket"
    },
    {
      "source": "/api/tournaments-status-transition",
      "destination": "/api/tournaments?route=status-transition"
    },
    {
      "source": "/api/member-showcase",
      "destination": "/api/owner?module=showcase"
    },
    {
      "source": "/api/shop",
      "destination": "/api/owner?module=shop"
    },
    {
      "source": "/api/owner/users",
      "destination": "/api/owner?action=users"
    },
    {
      "source": "/api/owner/audit",
      "destination": "/api/owner?action=audit"
    },
    {
      "source": "/api/owner/update-role",
      "destination": "/api/owner?action=update-role"
    },
    {
      "source": "/api/owner/set-blocked",
      "destination": "/api/owner?action=set-blocked"
    },
    {
      "source": "/api/owner/set-verified",
      "destination": "/api/owner?action=set-verified"
    },
    {
      "source": "/team",
      "destination": "/_seo/team.html"
    },
    {
      "source": "/team/academy",
      "destination": "/_seo/team__academy.html"
    },
    {
      "source": "/matches",
      "destination": "/_seo/matches.html"
    },
    {
      "source": "/tournaments",
      "destination": "/_seo/tournaments.html"
    },
    {
      "source": "/news",
      "destination": "/_seo/news.html"
    },
    {
      "source": "/history",
      "destination": "/_seo/history.html"
    },
    {
      "source": "/partners",
      "destination": "/_seo/partners.html"
    },
    {
      "source": "/collaborate",
      "destination": "/_seo/collaborate.html"
    },
    {
      "source": "/discord",
      "destination": "/_seo/discord.html"
    },
    {
      "source": "/highlights",
      "destination": "/_seo/highlights.html"
    },
    {
      "source": "/contacts",
      "destination": "/_seo/contacts.html"
    },
    {
      "source": "/support",
      "destination": "/_seo/support.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh"
}
