# Required. Keep this secret only in Railway Variables.
DISCORD_BOT_TOKEN=

# Optional. Defaults are already suitable for ISTe.
ISTE_MATCH_DATA_URL=https://istesport.com/data/faceit-stats.json
ISTE_SITE_URL=https://istesport.com
ISTE_IDLE_ACTIVITY=ISTe Esports • istesport.com
PRESENCE_REFRESH_MS=60000

# Optional. Two existing Discord role IDs assigned automatically to new human members.
# Example: DISCORD_AUTO_ROLE_IDS=123456789012345678,987654321098765432
DISCORD_AUTO_ROLE_IDS=

# Optional. Restrict auto-role assignment to one server.
DISCORD_AUTO_ROLE_GUILD_ID=
